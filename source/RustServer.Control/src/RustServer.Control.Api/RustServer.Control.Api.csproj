<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RustServer.Control.Application\RustServer.Control.Application.csproj" />
    <ProjectReference Include="..\RustServer.Control.Infrastructure\RustServer.Control.Infrastructure.csproj" />
    <ProjectReference Include="..\RustServer.Control.Domain\RustServer.Control.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NetworkAccess\systemd\rustserver-network-access-helper.service">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>network-access\systemd\rustserver-network-access-helper.service</TargetPath>
    </Content>
    <Content Include="NetworkAccess\nftables\rustserver-network-access-guard.nft">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>network-access\nftables\rustserver-network-access-guard.nft</TargetPath>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
