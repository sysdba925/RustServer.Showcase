# Required on every startup. Values must be supplied by the secret manager or
# this root-owned EnvironmentFile; never commit the populated file.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Non-secret identifier of the administrator created during first initialization.
Bootstrap__AdminUserName=admin

# Required only while the database has no users. Remove these after the first
# successful startup; they are not read once the bootstrap administrator exists.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password

# Optional standard ASP.NET Core configuration overrides.
# ConnectionStrings__AuthDatabase=Data Source=/var/lib/rustserver/auth/auth.db
# Kestrel__Endpoints__Http__Url=http://127.0.0.1:5286
