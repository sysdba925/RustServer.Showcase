<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\net10.0\linux-x64\publish\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net10.0</TargetFramework>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <GitHubReleaseDryRunArgument Condition="'$(GitHubReleaseDryRun)' == 'true'">-DryRun</GitHubReleaseDryRunArgument>
  </PropertyGroup>

  <Target Name="PublishProductionGitHubRelease" AfterTargets="AfterPublish">
    <Error Condition="'$(PublishIntermediateOutputPath)' == ''" Text="PublishIntermediateOutputPath was not set by MSBuild." />
    <PropertyGroup>
      <GitHubReleasePublishDirectory>$([System.Text.RegularExpressions.Regex]::Replace('$(PublishIntermediateOutputPath)', '[\\/]+$', ''))</GitHubReleasePublishDirectory>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\publish.ps1&quot; -Channel Production -PublishDirectory &quot;$(GitHubReleasePublishDirectory)&quot; -Repository &quot;sysdba925/RustServer.Plugins&quot; -RequiredBranch develop $(GitHubReleaseDryRunArgument)" />
  </Target>
</Project>
