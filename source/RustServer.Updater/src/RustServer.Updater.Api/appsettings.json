{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Operations": {
    "StoragePath": "/var/lib/rustserver/updater/operations"
  },
  "ApplicationRegistry": {
    "StoragePath": "/etc/rustserver/updater/applications.ini",
    "UpdaterApplicationName": "RustServer.Updater"
  },
  "PackagePreparation": {
    "StoragePath": "/var/lib/rustserver/updater/staging",
    "MaximumArchiveBytes": 536870912,
    "MaximumChecksumBytes": 1048576,
    "MaximumExtractedBytes": 1073741824,
    "MaximumArchiveEntries": 20000
  },
  "DeploymentExecutor": {
    "RequestStoragePath": "/var/lib/rustserver/updater/deployment-requests",
    "TransactionStoragePath": "/var/lib/rustserver/updater/deployments",
    "SocketPath": "/run/rustserver-deployment-executor.sock"
  },
  "AllowedHosts": "*"
}
