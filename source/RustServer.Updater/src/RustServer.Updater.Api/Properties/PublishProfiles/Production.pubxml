<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\net10.0\publish\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net10.0</TargetFramework>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <ProjectGuid>a0dc2f56-f3f8-26c7-3c83-1129d4c0a0da</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <GitHubReleaseDryRunArgument Condition="'$(GitHubReleaseDryRun)' == 'true'">-DryRun</GitHubReleaseDryRunArgument>
  </PropertyGroup>

  <Target Name="PublishBundledExecutor">
    <PropertyGroup>
      <GitHubReleaseExecutorDirectory>$(BaseIntermediateOutputPath)bundled-executor</GitHubReleaseExecutorDirectory>
      <RustServerExecutorProject>$(MSBuildProjectDirectory)\..\RustServer.Updater.Executor\RustServer.Updater.Executor.csproj</RustServerExecutorProject>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(RustServerExecutorProject)&quot; --configuration $(Configuration) --runtime $(RuntimeIdentifier) --self-contained false --output &quot;$(GitHubReleaseExecutorDirectory)&quot;" />
  </Target>

  <Target Name="PublishProductionGitHubRelease" AfterTargets="AfterPublish" DependsOnTargets="PublishBundledExecutor">
    <Error Condition="'$(PublishIntermediateOutputPath)' == ''" Text="PublishIntermediateOutputPath was not set by MSBuild." />
    <PropertyGroup>
      <GitHubReleasePublishDirectory>$([System.Text.RegularExpressions.Regex]::Replace('$(PublishIntermediateOutputPath)', '[\\/]+$', ''))</GitHubReleasePublishDirectory>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\publish.ps1&quot; -Channel Production -PublishDirectory &quot;$(GitHubReleasePublishDirectory)&quot; -ExecutorPublishDirectory &quot;$(GitHubReleaseExecutorDirectory)&quot; -Repository &quot;sysdba925/RustServer.Updater&quot; -RequiredBranch develop $(GitHubReleaseDryRunArgument)" />
  </Target>
</Project>
