{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "MediaStorage": {
    "Provider": "Local",
    "RootPath": ".local/plugin-catalog/media",
    "MaxUploadBytes": 10485760,
    "MaxDecodedPixels": 25000000,
    "MaxFrameCount": 300,
    "ThumbnailMaxDimension": 480
  },
  "AllowedHosts": "*"
}
