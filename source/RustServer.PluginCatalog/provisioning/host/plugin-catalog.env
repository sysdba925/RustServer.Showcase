# Catalog runtime and provisioning configuration. This file is created once by
# `provision.sh host`; edit it before running database or media provisioning.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5116

# Exact supported values in this artifact: PostgreSql and Local.
Database__Provider=PostgreSql
ConnectionStrings__PluginCatalog=Host=/var/run/postgresql;Database=rustserver_plugin_catalog;Username=rustserver-plugin-catalog

MediaStorage__Provider=Local
MediaStorage__RootPath=/var/lib/rustserver/plugin-catalog/media
MediaStorage__MaxUploadBytes=10485760
MediaStorage__MaxDecodedPixels=25000000
MediaStorage__MaxFrameCount=300
MediaStorage__ThumbnailMaxDimension=480

# Provisioning-only values. Keep the service user and PostgreSQL role equal so
# local PostgreSQL peer authentication needs no password.
Provisioning__ServiceUser=rustserver-plugin-catalog
Provisioning__PostgreSql__RoleName=rustserver-plugin-catalog
Provisioning__PostgreSql__DatabaseName=rustserver_plugin_catalog
