# Absolute Linux-host path. RustDedicated files, saves, and configuration remain here.
RUST_SERVER_PATH=/srv/rust/server

RUST_SERVER_PORT=28015
RUST_SERVER_QUERY_PORT=28017
# RCON address and port come from /etc/rustserver/topology.env.
# Store the RCON password separately in /etc/rustserver/rcon-password.
RUST_SERVER_LEVEL=Procedural Map
# Leave empty to allow Rust to choose a seed.
RUST_SERVER_SEED=150688647
RUST_SERVER_WORLD_SIZE=1000
RUST_SERVER_MAX_PLAYERS=5
RUST_SERVER_HOSTNAME=Rust Server
RUST_SERVER_DESCRIPTION=
RUST_SERVER_TICK_RATE=30
RUST_SERVER_SAVE_INTERVAL=600
RUST_SERVER_IDENTITY=rust-server
