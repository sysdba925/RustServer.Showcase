# RustServer platform topology. Copy to /etc/rustserver/topology.env.
# Keep values unquoted. This file contains addresses only; RCON's password
# is stored in /etc/rustserver/rcon-password.
RUSTSERVER_CONTROL_URL=http://127.0.0.1:5112
RUSTSERVER_VERSIONS_URL=http://127.0.0.1:5113
RUSTSERVER_PLUGINS_URL=http://127.0.0.1:5114
RUSTSERVER_SNAPSHOTS_URL=http://127.0.0.1:5115
RUSTSERVER_WEB_URL=http://127.0.0.1:5173
RUSTSERVER_RCON_URL=ws://127.0.0.1:28016
# These two endpoints are intentionally loopback-only. The first is the
# service-discovery address for gRPC clients; the second serves Swagger/OpenAPI.
RUSTSERVER_RCON_GRPC_URL=http://127.0.0.1:50051
RUSTSERVER_RCON_GRPC_DOCUMENTATION_URL=http://127.0.0.1:50052

# TEMPORARY DEVELOPMENT CONFIGURATION
# All HTTP services are reachable from the trusted development network.
# Before public deployment, change the five backend bind hosts to 127.0.0.1.
# Web remains accessible externally.
RUSTSERVER_CONTROL_BIND_HOST=0.0.0.0
RUSTSERVER_VERSIONS_BIND_HOST=0.0.0.0
RUSTSERVER_PLUGINS_BIND_HOST=0.0.0.0
RUSTSERVER_SNAPSHOTS_BIND_HOST=0.0.0.0
RUSTSERVER_WEB_BIND_HOST=0.0.0.0
