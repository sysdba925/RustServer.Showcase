# Version-controlled installation defaults for Production Bootstrap. This file
# contains no secrets and is parsed from the downloaded Bootstrap archive for
# each installation; Bootstrap never creates a persistent copy of it.

# Used only to create /etc/rustserver/updater.env when it is absent.
# Production Updater listens only on loopback.
RUSTSERVER_UPDATER_BIND_ADDRESS=127.0.0.1
RUSTSERVER_UPDATER_PORT=8080

# Optional path to a GitHub token file. Keep the token out of this file.
# The token file must be a regular file readable by the Bootstrap user and
# must not be accessible to group or other users.
# GITHUB_TOKEN_FILE=/home/ubuntu/.config/rustserver/github-token
